GEMINI_API_KEY=
# Modelo usado na classificação. Rode src/00_testar_api.py para ver os disponíveis.
GEMINI_MODEL=gemini-3.5-flash-lite
# Pausa entre chamadas, em segundos, para respeitar o limite por minuto do free tier.
PAUSA_ENTRE_CHAMADAS=5

# Modelo usado se o principal ficar sobrecarregado (erro 503). Deixe vazio para não usar.
GEMINI_MODEL_RESERVA=
# Modelo de embeddings da busca semântica (veja a lista em src/00_testar_api.py).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Lote e pausa dos embeddings (diminua o lote ou aumente a pausa se der erro 429).
EMBED_LOTE=10
EMBED_PAUSA=20
